{
  "name": "ilchon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/check-dist.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:match": "tsx scripts/check-match.ts",
    "check:currency": "tsx scripts/check-currency.ts",
    "check:storage": "tsx scripts/check-storage.ts",
    "check:seed": "tsx scripts/check-seed.ts",
    "check:list": "tsx scripts/check-list.ts",
    "check:bolt11": "tsx scripts/check-bolt11.ts",
    "check:relays": "tsx scripts/check-relays.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check:i18n-table": "tsx scripts/check-i18n-table.ts",
    "check:inbox": "tsx scripts/check-inbox.ts",
    "check:boot": "tsx scripts/check-boot.ts",
    "check:guard": "tsx scripts/check-guard.ts",
    "check:trade": "tsx scripts/check-trade.ts",
    "check:lnurl": "tsx scripts/check-lnurl.ts",
    "check:onchain": "tsx scripts/check-onchain.ts",
    "check:vectors": "tsx scripts/export-vectors.ts --check",
    "vectors": "tsx scripts/export-vectors.ts",
    "check:nostr-profile": "tsx --test src/lib/nostr-profile/index.test.ts",
    "check:history": "tsx --test src/screens/shell/overlay-history.test.ts",
    "check:support-log": "tsx scripts/check-support-log.ts",
    "check:engine": "tsx scripts/check-engine.ts",
    "check:csp": "tsx scripts/check-csp.ts",
    "check:a11y": "tsx scripts/check-a11y.ts",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "check:lint": "biome ci --diagnostic-level=error .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "i18n:table": "tsx scripts/i18n-table.ts",
    "i18n:import": "tsx scripts/i18n-import.ts",
    "check": "bash scripts/check-all.sh",
    "e2e": "tsx scripts/e2e.ts",
    "e2e:link-late": "tsx scripts/check-link-late.ts",
    "e2e:ui": "playwright test -c scripts/ui/playwright.config.ts"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.18 <25"
  },
  "dependencies": {
    "@internet-privacy/marmot-ts": "0.9.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.2.0",
    "@scure/bip39": "2.4.0",
    "applesauce-accounts": "7.0.2",
    "applesauce-common": "7.0.0",
    "applesauce-core": "7.0.3",
    "applesauce-loaders": "7.0.2",
    "applesauce-relay": "7.0.0",
    "applesauce-signers": "7.0.1",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rxjs": "^7.8.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "wrangler": "4.157.0"
  }
}
