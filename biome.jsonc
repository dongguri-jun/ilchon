{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  // Only ts and tsx. CSS, JSON and Markdown are not formatted or linted.
  "files": {
    "includes": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts", "vite.config.ts"]
  },
  // Import sorting is off: it would reorder imports across the whole tree.
  "assist": { "enabled": false },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    // 200 is the width that changed the fewest lines when the formatter was first applied to the
    // existing code (a trial of 17 widths and comma settings: 120 changed about 14k lines, 200 about 5k).
    "lineWidth": 200,
    "includes": [
      "**",
      // Generated by `pnpm i18n:import --normalize --write`; scripts/check-i18n.ts compares them byte for byte.
      "!**/ja-strings.ts",
      "!src/screens/shell/install-ja-strings.ts",
      // Not yet formatted; to be formatted in a separate format-only change.
      "!src/engine/index.ts",
      "!src/screens/room/**",
      "!src/screens/lock/**",
      "!src/screens/shell/overlay-history*",
      "!src/ui/sheet-back.ts",
      "!src/lib/support-log/**",
      "!vite.config.ts"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "quoteProperties": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        // Rules that point at real mistakes are errors (warnings under src/engine and src/lib, see overrides).
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noVoidTypeReturn": "error",
        // Off: fixing a dependency array changes when an effect runs, so each of the 12 sites needs
        // a person looking at the screen, not a mechanical fix. Revisit as its own task.
        "useExhaustiveDependencies": "off"
      },
      "suspicious": {
        "noPrototypeBuiltins": "error",
        "noControlCharactersInRegex": "error",
        "useIterableCallbackReturn": "error",
        "noExplicitAny": "error",
        // Off: `while ((m = re.exec(s)))` and similar assignments in a condition are deliberate (16 sites).
        "noAssignInExpressions": "off",
        // Off: the 7 lists keyed by index are fixed-length and never reordered.
        "noArrayIndexKey": "off",
        // Off: the flagged `${...}` are placeholders inside i18n strings, not forgotten template literals.
        "noTemplateCurlyInString": "off"
      },
      "complexity": {
        "noAdjacentSpacesInRegex": "error",
        "useMathMinMax": "error",
        "noUselessLoneBlockStatements": "error",
        // Off (taste, about 70 sites together): the code has its own consistent style here.
        "useOptionalChain": "off",
        "useLiteralKeys": "off",
        "noCommaOperator": "off",
        "noUselessUndefinedInitialization": "off"
      },
      "style": {
        // Off: 141 sites, mostly after a length or Map.has check that TypeScript cannot see.
        "noNonNullAssertion": "off",
        // Off: 23 sites, taste.
        "useTemplate": "off"
      },
      "a11y": {
        // Off: these 16 sites would change element types or keyboard behaviour, which is a UI
        // change, not a lint fix. scripts/check-a11y.ts covers contrast, landmarks and logo size.
        "useSemanticElements": "off",
        "useKeyWithClickEvents": "off",
        "noStaticElementInteractions": "off",
        "useFocusableInteractive": "off",
        "useAriaPropsSupportedByRole": "off"
      }
    }
  },
  "overrides": [
    {
      // src/engine and src/lib carry the "conditions never leak" promise, so rule hits there are warnings,
      // fixed by hand. src/screens/lock follows the same warning level.
      "includes": ["src/engine/**", "src/lib/**", "src/screens/lock/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "warn",
            "noUnusedVariables": "warn",
            "noVoidTypeReturn": "warn"
          },
          "suspicious": {
            "noPrototypeBuiltins": "warn",
            "noControlCharactersInRegex": "warn",
            "useIterableCallbackReturn": "warn",
            "noExplicitAny": "warn"
          },
          "complexity": {
            "noAdjacentSpacesInRegex": "warn",
            "useMathMinMax": "warn",
            "noUselessLoneBlockStatements": "warn"
          }
        }
      }
    }
  ]
}
